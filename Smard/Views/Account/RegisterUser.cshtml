<!-- MAIN CONTENT WRAPPER -->
<div class="dash-main-wrapper" id="main-wrapper">
    <div class="reg-container">

        <!-- LEFT HERO CARD -->
        <div class="hero-card">
            <div class="hero-top">
                <div class="hero-brand">
                    <span class="hero-brand-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </span>
                    <span class="hero-brand-name">Smard Admin</span>
                </div>
            </div>

            <div class="hero-middle">
                <h1 class="hero-title">Bring your team<br/>on board, securely.</h1>
                <p class="hero-subtitle">
                    Create accounts for new team members and get them access in seconds &mdash; no self-signup required.
                </p>

                <ul class="hero-features">
                    <li class="hero-feature-item">
                        <span class="hero-check-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        <span>Automatic role assignment</span>
                    </li>
                    <li class="hero-feature-item">
                        <span class="hero-check-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        <span>Enforced password strength</span>
                    </li>
                    <li class="hero-feature-item">
                        <span class="hero-check-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        <span>Instant account activation</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- RIGHT FORM CARD -->
        <div class="form-card">
            <div class="admin-pill">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10 11c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm9-4V7h-2v2h-2v2h2v2h2v-2h2V9h-2z"/>
                </svg>
                <span>ADMIN PANEL</span>
            </div>

            <h2 class="form-header-title">Register New User</h2>
            <p class="form-header-subtitle">Fill in the details below to create a new account.</p>

            <div class="role-notice-pill" id="roleNoticePill">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
                <span id="roleNoticeText">Will be assigned "User" role</span>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
            {
                <div class="alert-success-banner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <span>@ViewBag.SuccessMessage</span>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="alert-error-banner">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>@Html.ValidationSummary(true, "")</span>
                </div>
            }

            <form asp-controller="Account" asp-action="RegisterUser" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Full Name -->
                <div class="form-group">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </span>
                        <input asp-for="FullName" class="form-input" placeholder="Sudeep " autocomplete="name" required />
                    </div>
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <!-- User Type / Role Dropdown -->
                <div class="form-group">
                    <label asp-for="UserType" class="form-label">User Type / Role</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </span>
                        <select asp-for="UserType" class="form-input form-select" id="userTypeSelect" onchange="onRoleChange(this.value)" required>
                            <option value="User">Normal User</option>
                            <option value="Manager">Manager</option>
                        </select>
                        <span class="select-chevron">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </span>
                    </div>
                    <span asp-validation-for="UserType" class="field-error"></span>
                </div>

                <!-- Email Address -->
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <div class="input-wrapper">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </span>
                        <input asp-for="Email" type="email" class="form-input" placeholder="sudeep@smard.com" autocomplete="email" required />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <!-- Password and Confirm Password Row -->
                <div class="password-row">
                    <!-- Password -->
                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </span>
                            <input asp-for="Password" type="password" id="passInput" class="form-input has-toggle" placeholder="••••••••" autocomplete="new-password" required />
                            <button type="button" class="eye-toggle-btn" onclick="togglePasswordVisibility('passInput', this)" title="Toggle password visibility">
                                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg class="eye-closed" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                    <polyline points="22 4 12 14.01 9 11.01"/>
                                </svg>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPassInput" class="form-input has-toggle" placeholder="••••••••" autocomplete="new-password" required />
                            <button type="button" class="eye-toggle-btn" onclick="togglePasswordVisibility('confirmPassInput', this)" title="Toggle password visibility">
                                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg class="eye-closed" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                </div>

                <!-- Helper Note -->
                <div class="pwd-helper-note">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                    </svg>
                    <span>Min 8 characters, 1 number, 1 uppercase letter</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="submit-btn">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M10 11c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm9-4V7h-2v2h-2v2h2v2h2v-2h2V9h-2z"/>
                    </svg>
                    <span>Register User</span>
                </button>

                <!-- Back to Dashboard -->
                <div class="back-dashboard-row">
                    <a href="/Account/RequestQuotation" class="back-dashboard-link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"/>
                            <polyline points="12 19 5 12 12 5"/>
                        </svg>
                        <span>Back to Dashboard</span>
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        var main = document.getElementById('main-wrapper');
        var logo = document.getElementById('smard-logo-fixed');
        sidebar.classList.toggle('collapsed');
        main.classList.toggle('collapsed');
        if (logo) {
            logo.style.left = sidebar.classList.contains('collapsed') ? '80px' : '258px';
        }
    }

    function toggleMasters(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        var sidebar = document.getElementById('sidebar');
        if (sidebar && sidebar.classList.contains('collapsed')) {
            toggleSidebar();
            var submenu = document.getElementById('masters-submenu');
            var chevron = document.getElementById('masters-chevron');
            if (submenu) submenu.classList.remove('closed');
            if (chevron) chevron.classList.remove('closed');
            return;
        }

        var submenu = document.getElementById('masters-submenu');
        var chevron = document.getElementById('masters-chevron');
        if (submenu) submenu.classList.toggle('closed');
        if (chevron) chevron.classList.toggle('closed');
    }

    function toggleProfileMenu() {
        var dd = document.getElementById('profile-dropdown');
        if (dd) dd.classList.toggle('show');
    }

    document.addEventListener('click', function(e) {
        var profileArea = document.getElementById('profile-area');
        if (profileArea && !profileArea.contains(e.target)) {
            var dd = document.getElementById('profile-dropdown');
            if (dd) dd.classList.remove('show');
        }
    });

    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        if (!input) return;
        var eyeOpen = btn.querySelector('.eye-open');
        var eyeClosed = btn.querySelector('.eye-closed');
        if (input.type === 'password') {
            input.type = 'text';
            if (eyeOpen) eyeOpen.style.display = 'none';
            if (eyeClosed) eyeClosed.style.display = 'block';
        } else {
            input.type = 'password';
            if (eyeOpen) eyeOpen.style.display = 'block';
            if (eyeClosed) eyeClosed.style.display = 'none';
        }
    }

    function onRoleChange(val) {
        var pillText = document.getElementById('roleNoticeText');
        if (!pillText) return;
        if (val === 'Manager') {
            pillText.textContent = 'Will be assigned "Manager" role';
        } else {
            pillText.textContent = 'Will be assigned "User" role';
        }
    }

    // Initialize pill text based on current select value
    document.addEventListener('DOMContentLoaded', function () {
        var sel = document.getElementById('userTypeSelect');
        if (sel) {
            onRoleChange(sel.value);
        }
    });
</script>
}
