@section Scripts {
<script>
    var sidebarOpen = true;

    function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        var mainWrapper = document.getElementById('main-wrapper');
        var smardLogo = document.getElementById('smard-logo-fixed');

        sidebarOpen = !sidebarOpen;

        if (sidebarOpen) {
            sidebar.classList.remove('collapsed');
            mainWrapper.classList.remove('collapsed');
            smardLogo.classList.remove('show');
        } else {
            sidebar.classList.add('collapsed');
            mainWrapper.classList.add('collapsed');
            smardLogo.classList.add('show');
        }
    }

    function toggleProfileMenu() {
        var dd = document.getElementById('profile-dropdown');
        dd.classList.toggle('show');
    }

    function toggleMasters(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        var sidebar = document.getElementById('sidebar');
        if (sidebar && sidebar.classList.contains('collapsed')) {
            toggleSidebar();
            var submenu = document.getElementById('masters-submenu');
            var chevron = document.getElementById('masters-chevron');
            if (submenu) submenu.classList.remove('closed');
            if (chevron) chevron.classList.remove('closed');
            return;
        }

        var submenu = document.getElementById('masters-submenu');
        var chevron = document.getElementById('masters-chevron');
        if (submenu) submenu.classList.toggle('closed');
        if (chevron) chevron.classList.toggle('closed');
    }

    function selectSubItem(el) {
        var allSublinks = document.querySelectorAll('.nav-sublink');
        allSublinks.forEach(function(link) {
            link.classList.remove('active');
        });
        if (el) {
            el.classList.add('active');
        }
    }

    document.addEventListener('click', function(e) {
        var profileArea = document.getElementById('profile-area');
        if (profileArea && !profileArea.contains(e.target)) {
            document.getElementById('profile-dropdown').classList.remove('show');
        }
    });

    // Ensure smooth mouse wheel scrolling anywhere on the sidebar
    (function initSidebarScroll() {
        var sidebar = document.getElementById('sidebar');
        var sidebarNav = document.querySelector('.sidebar-nav');
        if (sidebar && sidebarNav) {
            sidebar.addEventListener('wheel', function(e) {
                if (sidebar.classList.contains('collapsed')) return;
                var maxScroll = sidebarNav.scrollHeight - sidebarNav.clientHeight;
                if (maxScroll > 0) {
                    sidebarNav.scrollTop += e.deltaY;
                    e.preventDefault();
                }
            }, { passive: false });
        }
    })();
</script>
}
