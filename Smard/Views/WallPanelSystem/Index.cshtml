                flex-shrink: 0;
            }

        /* Section label above tables */
        .cost-section-gap {
            margin-top: 24px;
        }

        /* =============================================
                   TOTAL AMOUNT GREEN BAR
                ============================================= */
        .total-mat-lab-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(90deg, #095C3E 0%, #0D734E 100%);
