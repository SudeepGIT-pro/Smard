                /* Type divider */
                '<div class="wps-type-divider">' +
                  '<div class="wps-type-divider-line"></div>' +
                  '<div class="wps-type-badge">TYPE ' + t + '</div>' +
                  '<div class="wps-type-divider-line"></div>' +
                '</div>' +

                /* Quick Guide */
