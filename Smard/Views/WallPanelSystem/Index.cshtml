        }

        /* OH & Profit row */
        .profit-ohrow td {
            background: #FFFBEB;
            font-weight: 600;
        }

            .profit-ohrow td .pct-input {
                background: #FEF3C7;
                border-color: #FCD34D;
                color: #92400E;
            }

                .profit-ohrow td .pct-input:focus {
                    border-color: #F59E0B;
                    box-shadow: 0 0 0 3px rgba(245,158,11,0.15);
                }

            .profit-ohrow td .pct-symbol {
                color: #92400E;
            }

        /* Amount cell in profit table */
        .profit-amount {
            font-size: 13px;
            font-weight: 700;
            color: #1E40AF;
            text-align: center;
            white-space: nowrap;
        }

        .profit-ohrow .profit-amount {
            color: #D97706;
        }

        /* Remarks input in profit table */
        .profit-remark {
            width: 100%;
            height: 32px;
            border: 1.5px solid #E2E8F0;
            border-radius: 20px;
            padding: 0 12px;
            font-size: 12px;
            font-family: 'Inter', sans-serif;
            color: var(--dark);
            background: #FAFBFF;
            outline: none;
            transition: border-color 0.2s;
        }

            .profit-remark:focus {
                border-color: var(--blue2);
                background: #fff;
            }

            .profit-remark::placeholder {
                color: #B0BEC5;
            }

        /* Total Rate row */
        .profit-totalrow td {
