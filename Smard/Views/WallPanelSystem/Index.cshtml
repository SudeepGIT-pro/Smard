                      'Add Row' +
                    '</span> to add items; ' +
                    '<span class="wps-guide-chip">Qty &times; Unit Rate</span> computes the amount.' +
                  '</div>' +
                '</div>' +

                /* ── Wall Panels Information card ── */
                '<div class="wps-card">' +
                  '<div class="wps-card-header">' +
                    '<svg viewBox="0 0 16 16">' +
                      '<path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>' +
                    '</svg>' +
                    '<span class="wps-card-header-title">Wall Panels Information</span>' +
                  '</div>' +

                  /* Row 1: TYPE */
                  '<div class="wps-row">' +
                    '<div class="wps-row-label"><span class="badge-type badge-blue">TYPE ' + t + '</span></div>' +
                    '<div class="wps-row-body">' +
                      '<input type="text" class="wps-input" id="wps-type-' + t + '" placeholder="e.g. Wall Panel Type" />' +
                    '</div>' +
                  '</div>' +

                  /* Row 2: WALL PANEL SYSTEM */
                  '<div class="wps-row">' +
                    '<div class="wps-row-label" style="align-items:flex-start;padding-top:14px;">' +
                      '<span class="badge-type badge-green">WALL PANEL SYSTEM</span>' +
                    '</div>' +
                    '<div class="wps-row-body" style="align-items:flex-start;">' +
                      '<textarea class="wps-textarea" id="wps-spec-' + t + '" placeholder="Describe the wall panel system specification..."></textarea>' +
                    '</div>' +
                  '</div>' +

                  /* Row 3: WALL PANEL SIZE */
                  '<div class="wps-row">' +
                    '<div class="wps-row-label" style="align-items:flex-start;padding-top:20px;">' +
                      '<span class="badge-type badge-orange">WALL PANEL SIZE</span>' +
                    '</div>' +
                    '<div class="wps-row-body">' +
                      '<div class="wps-size-group">' +
                        '<div class="wps-size-field">' +
                          '<div class="wps-size-label">LENGTH</div>' +
                          '<div class="wps-size-input-wrap">' +
                            '<input type="number" class="wps-size-input" id="wps-len-' + t + '" min="0" max="10000" step="0.01" oninput="onSizeInput(this, ' + t + ')" />' +
                            '<div class="wps-size-unit">m</div>' +
                          '</div>' +
                        '</div>' +
                        '<div class="wps-size-cross">&times;</div>' +
                        '<div class="wps-size-field">' +
                          '<div class="wps-size-label">HEIGHT</div>' +
                          '<div class="wps-size-input-wrap">' +
                            '<input type="number" class="wps-size-input" id="wps-ht-' + t + '" min="0" max="10000" step="0.01" oninput="onSizeInput(this, ' + t + ')" />' +
                            '<div class="wps-size-unit">m</div>' +
                          '</div>' +
                        '</div>' +
                      '</div>' +
