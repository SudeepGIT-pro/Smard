                flex-shrink: 0;
            }

            .cost-header-profit .cost-header-title {
                font-size: 14px;
                font-weight: 700;
                color: #fff;
            }

        /* Profit table */
        .profit-table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .profit-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 600px;
        }

        .profit-table,
        .profit-table th,
        .profit-table td {
            border-left: none !important;
            border-right: none !important;
        }

            .profit-table thead tr {
                background: #F8FAFC;
            }

            .profit-table thead th {
                padding: 10px 12px;
                font-size: 11px;
                font-weight: 800;
                color: #475569;
                text-align: center;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                border-bottom: 1.5px solid #E2E8F0;
                white-space: nowrap;
            }

                .profit-table thead th:first-child {
                    width: 60px;
                }

                .profit-table thead th.th-left {
                    text-align: left;
                    padding-left: 14px;
                }

            .profit-table tbody tr {
                border-bottom: 1px solid #F1F5F9;
                transition: background 0.15s;
            }

                .profit-table tbody tr:last-child {
                    border-bottom: none;
                }

                .profit-table tbody tr:hover {
