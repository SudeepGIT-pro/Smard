@section Scripts {
    <script>
        /* ================================================
           SIDEBAR
        ================================================ */
        var sidebarOpen = true;

        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var mainWrap = document.getElementById('main-wrapper');
            var logo = document.getElementById('smard-logo-fixed');
            var topStrip = document.getElementById('top-navbar-strip');
            sidebarOpen = !sidebarOpen;
            if (sidebarOpen) {
                sidebar.classList.remove('collapsed');
                mainWrap.classList.remove('collapsed');
                logo.classList.remove('show');
                if (topStrip) topStrip.classList.remove('collapsed');
            } else {
                sidebar.classList.add('collapsed');
                mainWrap.classList.add('collapsed');
                logo.classList.add('show');
                if (topStrip) topStrip.classList.add('collapsed');
            }
        }

        function toggleProfileMenu() {
            document.getElementById('profile-dropdown').classList.toggle('show');
        }

        function toggleMasters(e) {
            if (e) { e.preventDefault(); e.stopPropagation(); }
            var sidebar = document.getElementById('sidebar');
            if (sidebar && sidebar.classList.contains('collapsed')) { toggleSidebar(); }
            var submenu = document.getElementById('masters-submenu');
            var chevron = document.getElementById('masters-chevron');
            if (submenu) submenu.classList.toggle('closed');
            if (chevron) chevron.classList.toggle('closed');
        }

        function selectSubItem(el, title) {
            document.querySelectorAll('.nav-sublink').forEach(function (l) { l.classList.remove('active'); });
            if (el) el.classList.add('active');
        }

        document.addEventListener('click', function (e) {
            var pa = document.getElementById('profile-area');
            if (pa && !pa.contains(e.target)) {
                document.getElementById('profile-dropdown').classList.remove('show');
            }
        });

        (function () {
            var sidebar = document.getElementById('sidebar');
            var nav = document.querySelector('.sidebar-nav');
            if (sidebar && nav) {
                sidebar.addEventListener('wheel', function (e) {
                    if (sidebar.classList.contains('collapsed')) return;
                    var max = nav.scrollHeight - nav.clientHeight;
                    if (max > 0) { nav.scrollTop += e.deltaY; e.preventDefault(); }
                }, { passive: false });
            }
        })();

        /* ================================================
           WALL PANEL SYSTEM — COMPLETE TYPE BLOCKS
        ================================================ */
        var wpsCount = 0;

        function trashIcon() {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
                '<polyline points="3 6 5 6 21 6" stroke-linecap="round" stroke-linejoin="round"/>' +
                '<path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" stroke-linecap="round" stroke-linejoin="round"/>' +
                '<path d="M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/>' +
                '</svg>';
        }

