        .profit-totalrow td:first-child {
            text-align: left;
            padding-left: 16px;
            color: #78350F;
            font-size: 13px;
            font-weight: 800;
        }

        /* Warning badge */
        .total-rate-warn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            font-weight: 600;
            color: #B45309;
            background: #FEF3C7;
            border: 1px solid #FCD34D;
            border-radius: 6px;
            padding: 2px 8px;
            margin-left: 8px;
            white-space: nowrap;
        }

            .total-rate-warn svg {
                width: 12px;
                height: 12px;
                flex-shrink: 0;
            }

        /* =============================================
                   TYPE ACTION BAR
                ============================================= */
        .type-action-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            border: 1.5px solid var(--border);
            border-left: 4px solid #16A34A;
            border-radius: 10px;
            padding: 12px 20px;
            margin-top: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .type-action-label {
            font-size: 13px;
            font-weight: 800;
            color: #1E3A8A;
            letter-spacing: 1.5px;
        }

        .type-action-btns {
            display: flex;
            gap: 10px;
        }

        .type-save-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 20px;
            border-radius: 8px;
            background: linear-gradient(135deg, #15803D, #16A34A);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 3px 10px rgba(22,163,74,0.35);
            transition: background 0.2s, transform 0.15s;
        }

            .type-save-btn:hover {
                background: linear-gradient(135deg,#14532D,#15803D);
                transform: translateY(-1px);
            }

            .type-save-btn svg {
                width: 14px;
                height: 14px;
            }

        .type-del-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 18px;
            border-radius: 8px;
            background: linear-gradient(135deg, #DC2626, #EF4444);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 3px 10px rgba(220,38,38,0.35);
            transition: background 0.2s, transform 0.15s;
        }

            .type-del-btn:hover {
                background: linear-gradient(135deg,#991B1B,#DC2626);
                transform: translateY(-1px);
            }

            .type-del-btn svg {
                width: 14px;
                height: 14px;
            }

        /* =============================================
                   ADD TYPE BUTTON
                ============================================= */
        .add-type-wrap {
            display: flex;
            justify-content: center;
            margin-top: 24px;
            padding-bottom: 12px;
        }

        .add-type-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 32px;
            border-radius: 50px;
            background: linear-gradient(135deg, #0284C7, #0EA5E9);
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            box-shadow: 0 4px 16px rgba(2,132,199,0.40);
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            letter-spacing: 0.3px;
        }

            .add-type-btn:hover {
                background: linear-gradient(135deg,#0369A1,#0284C7);
                transform: translateY(-2px);
                box-shadow: 0 6px 22px rgba(2,132,199,0.5);
            }

            .add-type-btn:active {
                transform: translateY(0);
            }

            .add-type-btn svg {
                width: 18px;
                height: 18px;
            }

        /* Hide native spinner / arrow buttons on all number inputs globally */
        input::-webkit-outer-spin-button,
        input::-webkit-inner-spin-button {
            -webkit-appearance: none !important;
            margin: 0 !important;
        }

        input[type="number"] {
            -moz-appearance: textfield !important;
            appearance: textfield !important;
        }

        /* ── Limit Validation Error & Warning Styles ── */
        .wps-limit-error {
            border-color: #EF4444 !important;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.25) !important;
            animation: wps-limit-shake 0.35s ease-in-out !important;
        }

        @@keyframes wps-limit-shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        .wps-limit-tooltip {
            position: fixed;
            z-index: 999999;
            background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
            color: #FFFFFF;
            font-family: 'Inter', -apple-system, sans-serif;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.3px;
            padding: 6px 12px;
            border-radius: 8px;
            box-shadow: 0 6px 20px rgba(220, 38, 38, 0.4), 0 2px 6px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            gap: 6px;
            pointer-events: none;
            opacity: 0;
            transform: translateY(4px);
            transition: opacity 0.2s ease, transform 0.2s ease;
            white-space: nowrap;
        }

            .wps-limit-tooltip.show {
                opacity: 1;
                transform: translateY(0);
            }

            .wps-limit-tooltip::after {
                content: '';
                position: absolute;
                bottom: -6px;
                left: 50%;
                transform: translateX(-50%);
                border-width: 6px 6px 0;
                border-style: solid;
                border-color: #B91C1C transparent transparent transparent;
            }

            .wps-limit-tooltip.arrow-top::after {
                bottom: auto;
                top: -6px;
                border-width: 0 6px 6px;
                border-style: solid;
                border-color: transparent transparent #DC2626 transparent;
            }

        /* ── Custom Delete Modal ── */
        .del-modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.62);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            z-index: 9999999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

            .del-modal-backdrop.show {
                opacity: 1;
                pointer-events: auto;
            }

        .del-modal-card {
            position: relative;
            background: #FFFFFF;
            width: 100%;
            max-width: 440px;
            border-radius: 20px;
            padding: 34px 30px 28px 30px;
            text-align: center;
            box-shadow: 0 25px 60px -12px rgba(15, 23, 42, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transform: scale(0.92) translateY(10px);
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

            .del-modal-backdrop.show .del-modal-card {
                transform: scale(1) translateY(0);
            }

        .del-modal-top-accent {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: #DC2626;
        }

        .del-modal-icon-wrap {
            width: 76px;
            height: 76px;
            margin: 4px auto 18px auto;
            border-radius: 50%;
            background: #FEE2E2;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: background 0.2s ease;
        }

            .del-modal-icon-wrap::before {
                content: '';
                position: absolute;
                inset: -6px;
                border-radius: 50%;
                background: rgba(254, 226, 226, 0.45);
                z-index: 0;
            }

        .del-modal-icon-svg {
            position: relative;
            z-index: 1;
        }

        .del-modal-title {
            font-family: 'Inter', -apple-system, sans-serif;
            font-size: 22px;
            font-weight: 800;
            color: #0F172A;
            margin: 0 0 12px 0;
            letter-spacing: -0.3px;
            line-height: 1.3;
        }

        .del-modal-desc {
            font-family: 'Inter', -apple-system, sans-serif;
            font-size: 13.5px;
            line-height: 1.6;
            color: #64748B;
            margin: 0 0 26px 0;
            padding: 0 6px;
        }

            .del-modal-desc strong {
                font-weight: 700;
                color: #0F172A;
            }

        .del-modal-btns {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .del-btn-cancel {
            flex: 1;
            height: 44px;
            background: #F1F5F9;
            color: #334155;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            font-family: 'Inter', -apple-system, sans-serif;
            font-size: 13.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .del-btn-cancel:hover {
                background: #E2E8F0;
                color: #0F172A;
                transform: translateY(-1px);
            }

        .del-btn-confirm {
            flex: 1;
            height: 44px;
            background: #DC2626;
            color: #FFFFFF;
            border: none;
            border-radius: 12px;
            font-family: 'Inter', -apple-system, sans-serif;
            font-size: 13.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
            transition: all 0.2s ease;
        }

            .del-btn-confirm:hover {
                background: #B91C1C;
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(220, 38, 38, 0.45);
            }

        @@media (max-width: 768px) {
            .dash-sidebar.collapsed {
                width: 0;
            }

            .dash-main-wrapper.collapsed {
                margin-left: 0;
            }

            .top-navbar-strip {
                left: 0 !important;
            }

            .wps-page {
                padding: 82px 14px 40px 14px;
            }

            .wps-row-label {
                width: 120px;
            }

            .wps-header {
                flex-direction: column;
                gap: 14px;
                align-items: flex-start;
            }

            .total-mat-lab-value {
                font-size: 20px;
            }

            .type-action-bar {
                flex-direction: column;
                gap: 12px;
                align-items: flex-start;
            }
        }
    </style>
}

