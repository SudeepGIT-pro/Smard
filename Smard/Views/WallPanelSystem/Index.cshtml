                .profit-table td:first-child {
                    font-size: 13px;
                    font-weight: 700;
                    color: #475569;
                }

        /* Description text */
        .profit-desc {
            text-align: left !important;
            font-size: 13.5px !important;
            font-weight: 600 !important;
            color: #1E293B !important;
            padding-left: 14px !important;
            letter-spacing: 0.1px;
        }

        .profit-ohrow td.profit-desc {
            font-weight: 700 !important;
            color: #92400E !important;
        }

        /* Percentage badge-input */
        .pct-input-wrap {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            justify-content: center;
            margin: 0 auto;
        }

        .pct-input {
            width: 56px;
            height: 30px;
            border: 1.5px solid #BFDBFE;
            border-radius: 20px;
            padding: 0 8px;
            font-size: 13px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            color: #1E40AF;
            background: #EFF6FF;
            outline: none;
            text-align: center;
