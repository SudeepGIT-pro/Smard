        /* ── Add a complete type block ── */
        function addWpsType(shouldScroll) {
            wpsCount++;
            var t = wpsCount;
            var container = document.getElementById('wps-types-container');
            var wrapper = document.createElement('div');
            wrapper.innerHTML = buildTypeBlockHTML(t);
            container.appendChild(wrapper.firstElementChild);
            /* Seed initial rows for this type */
            addMatRowFor(t);
            addLabRowFor(t);
            if (shouldScroll) {
                var el = document.getElementById('wps-type-block-' + t);
                if (el) setTimeout(function () { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
            }
        }

        /* ================================================
           LIMIT VALIDATION & WARNING HELPERS
        ================================================ */
        var activeLimitTooltip = null;

        function showLimitWarning(input, msg) {
            if (!input) return;

            /* 1. Highlight input / container with error border & shake */
            var targetEl = input.closest('.wps-size-input-wrap') || input.closest('.pct-input-wrap') || input;
            targetEl.classList.remove('wps-limit-error');
            void targetEl.offsetWidth; /* Trigger DOM reflow to re-trigger shake animation */
            targetEl.classList.add('wps-limit-error');
            setTimeout(function () {
                targetEl.classList.remove('wps-limit-error');
            }, 1800);

            /* 2. Floating tooltip directly pointing at the input */
            if (activeLimitTooltip && activeLimitTooltip.parentNode) {
                activeLimitTooltip.parentNode.removeChild(activeLimitTooltip);
                activeLimitTooltip = null;
            }
            var tip = document.createElement('div');
            tip.className = 'wps-limit-tooltip';
            tip.innerHTML =
                '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">' +
                  '<path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>' +
                  '<line x1="12" y1="9" x2="12" y2="13"/>' +
                  '<line x1="12" y1="17" x2="12.01" y2="17"/>' +
                '</svg>' +
                '<span>' + msg + '</span>';
            document.body.appendChild(tip);
            activeLimitTooltip = tip;

            var rect = targetEl.getBoundingClientRect();
            var tipRect = tip.getBoundingClientRect();
            var tipTop = rect.top - tipRect.height - 8;
            if (tipTop < 10) {
                tipTop = rect.bottom + 8;
                tip.classList.add('arrow-top');
            }
            var tipLeft = rect.left + (rect.width / 2) - (tipRect.width / 2);
            tipLeft = Math.max(12, Math.min(window.innerWidth - tipRect.width - 12, tipLeft));
            tip.style.top = tipTop + 'px';
            tip.style.left = tipLeft + 'px';

            requestAnimationFrame(function () {
                tip.classList.add('show');
            });

            setTimeout(function () {
                if (tip.parentNode) {
                    tip.classList.remove('show');
                    setTimeout(function () { if (tip.parentNode) tip.parentNode.removeChild(tip); }, 250);
                }
            }, 2600);
        }

        function checkLimit(input, maxVal, unit) {
            if (!input || input.value === '') {
                if (input) input.setAttribute('data-last-valid', '');
                return true;
            }
            var val = parseFloat(input.value);
            if (isNaN(val)) return true;
            if (val < 0) {
                input.value = '0';
                input.setAttribute('data-last-valid', '0');
                return true;
            }
            if (val > maxVal) {
                var lastVal = input.getAttribute('data-last-valid');
                input.value = (lastVal !== null && lastVal !== undefined && lastVal !== '') ? lastVal : '';
                var msg = (unit === '%' || maxVal === 100)
                    ? "can't exceed more than 100"
                    : "can't exceed more than 10000";
                showLimitWarning(input, msg);
                return false;
            }
            input.setAttribute('data-last-valid', input.value);
            return true;
        }

        function onSizeInput(input, t) {
            if (input) checkLimit(input, 10000);
            calcArea(t);
        }

        function onProfitPctInput(input, t) {
            if (input) checkLimit(input, 100, '%');
            recalcProfit(t);
        }

        /* ── Area calculation ── */
        function calcArea(t) {
            var lenEl = document.getElementById('wps-len-' + t);
            var htEl  = document.getElementById('wps-ht-' + t);
            var areaEl = document.getElementById('wps-area-' + t);
            if (!lenEl || !htEl || !areaEl) return;
            if (parseFloat(lenEl.value) > 10000) lenEl.value = lenEl.getAttribute('data-last-valid') || '';
            if (parseFloat(htEl.value) > 10000) htEl.value = htEl.getAttribute('data-last-valid') || '';
            var len = parseFloat(lenEl.value);
            var ht  = parseFloat(htEl.value);
            var area = (!isNaN(len) && !isNaN(ht) && len >= 0 && ht >= 0) ? len * ht : 0;
            areaEl.textContent = area.toFixed(2);
            recalcMatTotalsFor(t);
            recalcLabTotalsFor(t);
        }

        /* ================================================
           PER-TYPE MATERIAL COST HELPERS
        ================================================ */
        var matRowCounts = {};

        function buildMatRow(t, idx) {
            var rid = 'mat-r-' + t + '-' + idx;
            var tr = document.createElement('tr');
            tr.id = rid;
            tr.innerHTML =
                '<td class="sl-mat-' + t + '">' + idx + '</td>' +
                '<td><input class="ct-input" type="text" placeholder="Item Description" /></td>' +
                '<td><input class="ct-input" type="text" placeholder="Specification" /></td>' +
                '<td><input class="ct-input ct-input-unit" type="text" placeholder="Unit" /></td>' +
                '<td><input class="ct-input ct-input-sm" type="number" placeholder="" min="0" max="10000" step="0.01" oninput="onMatRowInput(this,' + t + ')" /></td>' +
                '<td><input class="ct-input ct-input-sm" type="number" placeholder="" min="0" max="10000" step="0.01" oninput="onMatRowInput(this,' + t + ')" /></td>' +
                '<td><input class="ct-input ct-input-sm ct-amount" type="text" value="0.00" readonly tabindex="-1" /></td>' +
                '<td><input class="ct-input" type="text" placeholder="Remarks" /></td>' +
                '<td><button class="ct-del-btn" type="button" onclick="delMatRow(\'' + rid + '\',' + t + ')" title="Delete Row">' + trashIcon() + '</button></td>';
            return tr;
        }

        function addMatRowFor(t) {
            if (!matRowCounts[t]) matRowCounts[t] = 0;
            matRowCounts[t]++;
            var tbody = document.getElementById('mat-tbody-' + t);
            if (!tbody) return;
            tbody.appendChild(buildMatRow(t, matRowCounts[t]));
            recalcMatTotalsFor(t);
        }

        function delMatRow(rid, t) {
            var tr = document.getElementById(rid);
            if (!tr) return;
            var tbody = document.getElementById('mat-tbody-' + t);
            if (!tbody || tbody.rows.length <= 1) return;
            tr.parentNode.removeChild(tr);
            renumberRows(tbody, 'sl-mat-' + t);
            recalcMatTotalsFor(t);
        }

        function onMatRowInput(input, t) {
            if (input) checkLimit(input, 10000);
            var tr = input ? input.closest('tr') : null;
            if (!tr) return;
            var cells = tr.querySelectorAll('input[type="number"]');
            var qnty = parseFloat(cells[0].value);
            var rate = parseFloat(cells[1].value);
            var amt = (!isNaN(qnty) && !isNaN(rate)) ? qnty * rate : 0;
            var ro = tr.querySelector('.ct-amount, input[readonly]');
            if (ro) ro.value = amt.toFixed(2);
            recalcMatTotalsFor(t);
        }

        function getAreaFor(t) {
            var el = document.getElementById('wps-area-' + t);
            if (!el) return 0;
            var v = parseFloat(el.textContent);
            return isNaN(v) ? 0 : v;
        }

        function recalcMatTotalsFor(t) {
            var tbody = document.getElementById('mat-tbody-' + t);
            if (!tbody) return;
            var total = 0;
            for (var i = 0; i < tbody.rows.length; i++) {
                var ro = tbody.rows[i].querySelector('.ct-amount, input[readonly]');
                if (ro) total += parseFloat(ro.value) || 0;
            }
            var el = document.getElementById('mat-total-' + t);
            if (el) el.textContent = total.toFixed(2);
            var area = getAreaFor(t);
            var el2 = document.getElementById('mat-per-m2-' + t);
            if (el2) el2.textContent = (area > 0 ? (total / area) : 0).toFixed(2);
            recalcTotalMatLabFor(t);
        }

        /* ================================================
           PER-TYPE LABOUR COST HELPERS
        ================================================ */
        var labRowCounts = {};

        function buildLabRow(t, idx) {
            var rid = 'lab-r-' + t + '-' + idx;
            var tr = document.createElement('tr');
            tr.id = rid;
            tr.innerHTML =
                '<td class="sl-lab-' + t + '">' + idx + '</td>' +
                '<td><input class="ct-input" type="text" placeholder="Item Description" /></td>' +
                '<td><input class="ct-input" type="text" placeholder="Specification" /></td>' +
                '<td><input class="ct-input ct-input-unit" type="text" placeholder="Unit" /></td>' +
                '<td><input class="ct-input ct-input-sm" type="number" placeholder="" min="0" max="10000" step="0.01" oninput="onLabRowInput(this,' + t + ')" /></td>' +
                '<td><input class="ct-input ct-input-sm" type="number" placeholder="" min="0" max="10000" step="0.01" oninput="onLabRowInput(this,' + t + ')" /></td>' +
                '<td><input class="ct-input ct-input-sm ct-amount" type="text" value="0.00" readonly tabindex="-1" /></td>' +
                '<td><input class="ct-input" type="text" placeholder="Remarks" /></td>' +
                '<td><button class="ct-del-btn" type="button" onclick="delLabRow(\'' + rid + '\',' + t + ')" title="Delete Row">' + trashIcon() + '</button></td>';
            return tr;
        }

        function addLabRowFor(t) {
            if (!labRowCounts[t]) labRowCounts[t] = 0;
            labRowCounts[t]++;
            var tbody = document.getElementById('lab-tbody-' + t);
            if (!tbody) return;
            tbody.appendChild(buildLabRow(t, labRowCounts[t]));
            recalcLabTotalsFor(t);
        }

        function delLabRow(rid, t) {
            var tr = document.getElementById(rid);
            if (!tr) return;
            var tbody = document.getElementById('lab-tbody-' + t);
            if (!tbody || tbody.rows.length <= 1) return;
            tr.parentNode.removeChild(tr);
            renumberRows(tbody, 'sl-lab-' + t);
            recalcLabTotalsFor(t);
        }

        function onLabRowInput(input, t) {
            if (input) checkLimit(input, 10000);
            var tr = input ? input.closest('tr') : null;
            if (!tr) return;
            var cells = tr.querySelectorAll('input[type="number"]');
            var qnty = parseFloat(cells[0].value);
            var rate = parseFloat(cells[1].value);
            var amt = (!isNaN(qnty) && !isNaN(rate)) ? qnty * rate : 0;
            var ro = tr.querySelector('.ct-amount, input[readonly]');
            if (ro) ro.value = amt.toFixed(2);
            recalcLabTotalsFor(t);
        }

        function recalcLabTotalsFor(t) {
            var tbody = document.getElementById('lab-tbody-' + t);
            if (!tbody) return;
            var total = 0;
            for (var i = 0; i < tbody.rows.length; i++) {
                var ro = tbody.rows[i].querySelector('.ct-amount, input[readonly]');
                if (ro) total += parseFloat(ro.value) || 0;
            }
            var el = document.getElementById('lab-total-' + t);
            if (el) el.textContent = total.toFixed(2);
            var area = getAreaFor(t);
            var el2 = document.getElementById('lab-per-m2-' + t);
            if (el2) el2.textContent = (area > 0 ? (total / area) : 0).toFixed(2);
            recalcTotalMatLabFor(t);
        }

        /* ================================================
           PER-TYPE TOTAL + PROFIT
        ================================================ */
        function recalcTotalMatLabFor(t) {
            var matPerM2 = parseFloat((document.getElementById('mat-per-m2-' + t) || {}).textContent) || 0;
            var labPerM2 = parseFloat((document.getElementById('lab-per-m2-' + t) || {}).textContent) || 0;
            var base = matPerM2 + labPerM2;
            var el = document.getElementById('total-mat-lab-val-' + t);
            if (el) el.textContent = base.toFixed(2);
            recalcProfit(t);
        }

        function recalcProfit(t) {
            var base = parseFloat((document.getElementById('total-mat-lab-val-' + t) || {}).textContent) || 0;
            var pT = parseFloat((document.getElementById('pct-transport-' + t) || {}).value) || 0;
            var pW = parseFloat((document.getElementById('pct-water-' + t) || {}).value) || 0;
            var pTo = parseFloat((document.getElementById('pct-tools-' + t) || {}).value) || 0;
            var pO = parseFloat((document.getElementById('pct-oh-' + t) || {}).value) || 0;
            var aT = base * pT / 100;
            var aW = base * pW / 100;
            var aTo = base * pTo / 100;
            var aO = base * pO / 100;
            var setTxt = function(id, v) { var e = document.getElementById(id); if (e) e.textContent = v.toFixed(2); };
            setTxt('amt-transport-' + t, aT);
            setTxt('amt-water-' + t, aW);
            setTxt('amt-tools-' + t, aTo);
            setTxt('amt-oh-' + t, aO);
            setTxt('amt-total-rate-' + t, base + aT + aW + aTo + aO);
            var warnEl = document.getElementById('total-rate-warn-' + t);
            if (warnEl) warnEl.style.display = (base <= 0) ? 'inline-flex' : 'none';
        }

        /* ================================================
           SAVE / DELETE PER TYPE
        ================================================ */
        function saveType(t) {
            var btn = document.getElementById('type-save-btn-' + t);
            if (!btn) return;
            var orig = btn.innerHTML;
            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/></svg> Saved!';
            btn.style.background = 'linear-gradient(135deg,#14532D,#15803D)';
            setTimeout(function () { btn.innerHTML = orig; btn.style.background = ''; }, 2000);
        }

        /* ================================================
           CUSTOM DELETE TYPE MODAL
        ================================================ */
        var pendingDeleteTypeId = null;

        function deleteType(t) {
            pendingDeleteTypeId = t;
            var modal = document.getElementById('del-type-modal');
            var title = document.getElementById('del-modal-title');
            var desc = document.getElementById('del-modal-desc');
            var btns = document.getElementById('del-modal-btns');
            var iconWrap = document.getElementById('del-modal-icon-wrap');

            /* Reset icon to red warning triangle */
            iconWrap.innerHTML =
                '<svg class="del-modal-icon-svg" viewBox="0 0 24 24" width="34" height="34" fill="none">' +
                  '<path d="M12 3.5L2 20.5h20L12 3.5z" fill="#DC2626"/>' +
                  '<line x1="12" y1="9" x2="12" y2="14" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round"/>' +
                  '<circle cx="12" cy="17.5" r="1.1" fill="#ffffff"/>' +
                '</svg>';
            iconWrap.style.background = '#FEE2E2';

            title.textContent = 'Delete TYPE ' + t + ' Section?';
            desc.innerHTML = 'This will permanently remove the type section along with all its <strong>Material Cost</strong>, <strong>Labour Cost</strong> and <strong>Profit</strong> data. This action cannot be undone.';

            btns.innerHTML =
                '<button type="button" class="del-btn-cancel" onclick="closeDelTypeModal()">' +
                  '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">' +
                    '<circle cx="12" cy="12" r="10"/>' +
                    '<line x1="15" y1="9" x2="9" y2="15" stroke-linecap="round"/>' +
                    '<line x1="9" y1="9" x2="15" y2="15" stroke-linecap="round"/>' +
                  '</svg>' +
                  'Cancel' +
                '</button>' +
                '<button type="button" class="del-btn-confirm" id="del-confirm-btn" onclick="confirmDeleteType()">' +
                  '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">' +
                    '<path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>' +
                  '</svg>' +
                  'Yes, Delete' +
                '</button>';

            modal.classList.add('show');
        }


        function closeDelTypeModal() {
            var modal = document.getElementById('del-type-modal');
            if (modal) modal.classList.remove('show');
            pendingDeleteTypeId = null;
        }

        function onDelModalBackdropClick(e) {
            if (e.target && e.target.classList.contains('del-modal-backdrop')) {
                closeDelTypeModal();
            }
        }

        function confirmDeleteType() {
            if (pendingDeleteTypeId === null) return;
            var block = document.getElementById('wps-type-block-' + pendingDeleteTypeId);
            if (block) block.parentNode.removeChild(block);
            closeDelTypeModal();

            /* Renumber all remaining type blocks to maintain continuous 1, 2, 3 sequence */
            renumberAllTypes();

            /* If no types remain, scroll the Add Type button into view */
            var remaining = document.querySelectorAll('.wps-type-block').length;
            if (remaining === 0) {
                var addBtn = document.getElementById('add-type-btn');
                if (addBtn) setTimeout(function () { addBtn.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 100);
            }
        }

        /* ================================================
           RENUMBER ALL TYPES TO MAINTAIN CONTINUOUS SEQUENCE
        ================================================ */
        function renumberAllTypes() {
            var container = document.getElementById('wps-types-container');
            if (!container) return;
            var blocks = container.querySelectorAll('.wps-type-block');

            blocks.forEach(function (block, index) {
                var newT = index + 1;
                /* Extract previous type number from id (e.g. "wps-type-block-3") */
                var oldT = parseInt(block.id.replace('wps-type-block-', ''), 10);
                if (isNaN(oldT)) return;

                /* 1. Update block ID */
                block.id = 'wps-type-block-' + newT;

                /* 2. Visible labels */
                var badgeTop = block.querySelector('.wps-type-badge');
                if (badgeTop) badgeTop.textContent = 'TYPE ' + newT;
                var badgeInfo = block.querySelector('.badge-type.badge-blue');
                if (badgeInfo) badgeInfo.textContent = 'TYPE ' + newT;
                var actionLabel = block.querySelector('.type-action-label');
                if (actionLabel) actionLabel.textContent = 'TYPE ' + newT;

                var costPrefixes = ['mat', 'lab'];
                costPrefixes.forEach(function (cType) {
                    var tb = block.querySelector('#' + cType + '-tbody-' + oldT) || block.querySelector('#' + cType + '-tbody-' + newT);
                    var costSec = tb ? tb.closest('.cost-section') : null;
                    var addWrap = costSec ? costSec.querySelector('.cost-add-wrap') : null;
                    if (!addWrap) return;
                    var copyBtn = addWrap.querySelector('.cost-copy-btn');
                    if (newT === 1) {
                        if (copyBtn && copyBtn.parentNode) copyBtn.parentNode.removeChild(copyBtn);
                    } else {
                        var copySvg = '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z"/></svg>';
                        if (!copyBtn) {
                            copyBtn = document.createElement('button');
                            copyBtn.className = 'cost-copy-btn';
                            copyBtn.type = 'button';
                            addWrap.appendChild(copyBtn);
                        }
                        copyBtn.id = cType + '-copy-btn-' + newT;
                        copyBtn.setAttribute('onclick', "copyCostDetails('" + cType + "'," + newT + ")");
                        copyBtn.innerHTML = copySvg + ' Copy from TYPE ' + (newT - 1);
                    }
                });

                /* If oldT === newT, visual labels are confirmed; skip ID mutations */
                if (oldT === newT) return;

                /* 3. Wall Panels Info inputs & handlers */
                var elType = block.querySelector('#wps-type-' + oldT);
                if (elType) elType.id = 'wps-type-' + newT;

                var elSpec = block.querySelector('#wps-spec-' + oldT);
                if (elSpec) elSpec.id = 'wps-spec-' + newT;

                var elLen = block.querySelector('#wps-len-' + oldT);
                if (elLen) {
                    elLen.id = 'wps-len-' + newT;
                    elLen.setAttribute('oninput', 'onSizeInput(this, ' + newT + ')');
                }

                var elHt = block.querySelector('#wps-ht-' + oldT);
                if (elHt) {
                    elHt.id = 'wps-ht-' + newT;
                    elHt.setAttribute('oninput', 'onSizeInput(this, ' + newT + ')');
                }

                var elAreaBox = block.querySelector('#wps-area-box-' + oldT);
                if (elAreaBox) elAreaBox.id = 'wps-area-box-' + newT;

                var elArea = block.querySelector('#wps-area-' + oldT);
                if (elArea) elArea.id = 'wps-area-' + newT;

                /* 4. Material Cost table */
                var matTbody = block.querySelector('#mat-tbody-' + oldT);
                if (matTbody) {
                    matTbody.id = 'mat-tbody-' + newT;
                    var matRows = matTbody.querySelectorAll('tr');
                    matRows.forEach(function (tr, rIdx) {
                        var rowNum = rIdx + 1;
                        var newRid = 'mat-r-' + newT + '-' + rowNum;
                        tr.id = newRid;
                        var slCell = tr.querySelector('.sl-mat-' + oldT) || tr.cells[0];
                        if (slCell) {
                            slCell.className = 'sl-mat-' + newT;
                            slCell.textContent = rowNum;
                        }
                        var numInputs = tr.querySelectorAll('input[type="number"]');
                        numInputs.forEach(function (inp) {
                            inp.setAttribute('oninput', 'onMatRowInput(this,' + newT + ')');
                        });
                        var delBtn = tr.querySelector('.ct-del-btn');
                        if (delBtn) {
                            delBtn.setAttribute('onclick', "delMatRow('" + newRid + "'," + newT + ")");
                        }
                    });
                }

                var matTotal = block.querySelector('#mat-total-' + oldT);
                if (matTotal) matTotal.id = 'mat-total-' + newT;

                var matPerM2 = block.querySelector('#mat-per-m2-' + oldT);
                if (matPerM2) matPerM2.id = 'mat-per-m2-' + newT;

                var matAddBtn = block.querySelector('button[onclick*="addMatRowFor"]');
                if (matAddBtn) matAddBtn.setAttribute('onclick', 'addMatRowFor(' + newT + ')');

                /* 5. Labour Cost table */
                var labTbody = block.querySelector('#lab-tbody-' + oldT);
                if (labTbody) {
                    labTbody.id = 'lab-tbody-' + newT;
                    var labRows = labTbody.querySelectorAll('tr');
                    labRows.forEach(function (tr, rIdx) {
                        var rowNum = rIdx + 1;
                        var newRid = 'lab-r-' + newT + '-' + rowNum;
                        tr.id = newRid;
                        var slCell = tr.querySelector('.sl-lab-' + oldT) || tr.cells[0];
                        if (slCell) {
                            slCell.className = 'sl-lab-' + newT;
                            slCell.textContent = rowNum;
                        }
                        var numInputs = tr.querySelectorAll('input[type="number"]');
                        numInputs.forEach(function (inp) {
                            inp.setAttribute('oninput', 'onLabRowInput(this,' + newT + ')');
                        });
                        var delBtn = tr.querySelector('.ct-del-btn');
                        if (delBtn) {
                            delBtn.setAttribute('onclick', "delLabRow('" + newRid + "'," + newT + ")");
                        }
                    });
                }

                var labTotal = block.querySelector('#lab-total-' + oldT);
                if (labTotal) labTotal.id = 'lab-total-' + newT;

                var labPerM2 = block.querySelector('#lab-per-m2-' + oldT);
                if (labPerM2) labPerM2.id = 'lab-per-m2-' + newT;

                var labAddBtn = block.querySelector('button[onclick*="addLabRowFor"]');
                if (labAddBtn) labAddBtn.setAttribute('onclick', 'addLabRowFor(' + newT + ')');

                /* 6. Total Amount Bar */
                var totBar = block.querySelector('#total-mat-lab-val-' + oldT);
                if (totBar) totBar.id = 'total-mat-lab-val-' + newT;

                /* 7. With Profit section */
                var pctT = block.querySelector('#pct-transport-' + oldT);
                if (pctT) {
                    pctT.id = 'pct-transport-' + newT;
                    pctT.setAttribute('oninput', 'onProfitPctInput(this, ' + newT + ')');
                }
                var amtT = block.querySelector('#amt-transport-' + oldT);
                if (amtT) amtT.id = 'amt-transport-' + newT;

                var pctW = block.querySelector('#pct-water-' + oldT);
                if (pctW) {
                    pctW.id = 'pct-water-' + newT;
                    pctW.setAttribute('oninput', 'onProfitPctInput(this, ' + newT + ')');
                }
                var amtW = block.querySelector('#amt-water-' + oldT);
                if (amtW) amtW.id = 'amt-water-' + newT;

                var pctTools = block.querySelector('#pct-tools-' + oldT);
                if (pctTools) {
                    pctTools.id = 'pct-tools-' + newT;
                    pctTools.setAttribute('oninput', 'onProfitPctInput(this, ' + newT + ')');
                }
                var amtTools = block.querySelector('#amt-tools-' + oldT);
                if (amtTools) amtTools.id = 'amt-tools-' + newT;

                var pctOH = block.querySelector('#pct-oh-' + oldT);
                if (pctOH) {
                    pctOH.id = 'pct-oh-' + newT;
                    pctOH.setAttribute('oninput', 'onProfitPctInput(this, ' + newT + ')');
                }
                var amtOH = block.querySelector('#amt-oh-' + oldT);
                if (amtOH) amtOH.id = 'amt-oh-' + newT;

                var warn = block.querySelector('#total-rate-warn-' + oldT);
                if (warn) warn.id = 'total-rate-warn-' + newT;

                var amtTot = block.querySelector('#amt-total-rate-' + oldT);
                if (amtTot) amtTot.id = 'amt-total-rate-' + newT;

                /* 8. Type Action Bar buttons */
                var saveBtn = block.querySelector('#type-save-btn-' + oldT);
                if (saveBtn) {
                    saveBtn.id = 'type-save-btn-' + newT;
                    saveBtn.setAttribute('onclick', 'saveType(' + newT + ')');
                }

                var delBtn = block.querySelector('.type-del-btn');
                if (delBtn) {
                    delBtn.setAttribute('onclick', 'deleteType(' + newT + ')');
                }
            });

            /* Resync global type counter and row count dictionaries */
            wpsCount = blocks.length;
            matRowCounts = {};
            labRowCounts = {};
            blocks.forEach(function (b, idx) {
                var t = idx + 1;
                var mTb = b.querySelector('#mat-tbody-' + t);
                var lTb = b.querySelector('#lab-tbody-' + t);
                matRowCounts[t] = mTb ? mTb.querySelectorAll('tr').length : 0;
                labRowCounts[t] = lTb ? lTb.querySelectorAll('tr').length : 0;
            });
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeDelTypeModal();
            }
        });

        /* ================================================
           UTILITY
        ================================================ */
        function renumberRows(tbody, slClass) {
            var cells = tbody.querySelectorAll('.' + slClass);
            for (var i = 0; i < cells.length; i++) {
                cells[i].textContent = i + 1;
            }
        }

        function scrollToTopIfCurrent(e) {
            var mainWrap = document.getElementById('main-wrapper');
            if (mainWrap) mainWrap.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /* ================================================
           INIT — create first type on page load
        ================================================ */
        document.addEventListener('DOMContentLoaded', function () {
            addWpsType(false);
            var mainWrap = document.getElementById('main-wrapper');
            if (mainWrap) mainWrap.scrollTop = 0;
            window.scrollTo(0, 0);
        });

        /* ================================================
           GLOBAL FIX — prevent mouse-wheel from changing
           number input values anywhere on this page.
           Uses capture phase so it works for dynamically
           injected inputs (cost table rows, profit %, etc.)
        ================================================ */
        document.addEventListener('wheel', function (e) {
            if (document.activeElement && document.activeElement.type === 'number') {
                document.activeElement.blur();
            }
        }, { passive: true, capture: true });

        /* ================================================
           GLOBAL LIMIT VALIDATION & NUMERIC KEY FILTER
        ================================================ */
        document.addEventListener('keydown', function (e) {
            if (e.target && e.target.type === 'number') {
                if (e.key === '-' || e.key === 'e' || e.key === 'E' || e.key === '+') {
                    e.preventDefault();
                }
            }
        }, true);

        document.addEventListener('input', function (e) {
            var target = e.target;
            if (!target) return;
            if (target.classList && target.classList.contains('pct-input')) {
                checkLimit(target, 100, '%');
            } else if (target.classList && (target.classList.contains('wps-size-input') || (target.classList.contains('ct-input') && target.type === 'number'))) {
                checkLimit(target, 10000);
            }
        }, true);

        document.addEventListener('change', function (e) {
            var target = e.target;
            if (!target) return;
            if (target.classList && target.classList.contains('pct-input')) {
                checkLimit(target, 100, '%');
            } else if (target.classList && (target.classList.contains('wps-size-input') || (target.classList.contains('ct-input') && target.type === 'number'))) {
                checkLimit(target, 10000);
            }
        }, true);
    </script>
}
